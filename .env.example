# SYNTARA AI — Universal Autonomous Intelligence Operating System
# Version 1.0 (MIT Open Source)

# GEMINI_API_KEY: Server-side AI provider key injected automatically at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public or local URL of the SYNTARA instance.
APP_URL="http://localhost:3000"

# Model Adapter Configuration (Model-Agnostic)
SYNTARA_DEFAULT_PROVIDER="gemini"
OLLAMA_BASE_URL="http://localhost:11434"
LITELLM_PROXY_URL="http://localhost:4000"
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"

# Database & Orchestration (Docker / Self-Hosted Server Mode)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="syntara"
POSTGRES_USER="syntara_admin"
POSTGRES_PASSWORD="change_me_in_production"
REDIS_URL="redis://localhost:6379/0"

# Trust Engine & Execution Sandbox Quotas
SYNTARA_MAX_TOKENS_PER_MISSION="120000"
SYNTARA_MAX_COST_USD_PER_MISSION="5.00"
SYNTARA_SANDBOX_TIMEOUT_MS="30000"
